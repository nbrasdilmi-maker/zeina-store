# ==========================================
# 🛡️ Zeina Store - Environment Variables (Demo Mode)
# ⚠️ CHANGE ALL SECRETS IN PRODUCTION!
# ==========================================

# --- Database (Neon via Vercel Marketplace) ---
# Get these from Neon dashboard after creating a database
DATABASE_URL="postgresql://user:password@neon-endpoint.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@neon-endpoint.neon.tech/dbname?sslmode=require"

# --- Authentication & Security ---
# ⚠️ CRITICAL: Generate with: openssl rand -base64 64
JWT_SECRET="CHANGE_ME_TO_RANDOM_64_CHAR_STRING_NOW"
JWT_REFRESH_SECRET="CHANGE_ME_TO_ANOTHER_RANDOM_STRING"
NEXTAUTH_SECRET="CHANGE_THIS_TOO"
BCRYPT_SALT_ROUNDS="12"

# --- Admin Account (for demo reference only) ---
ADMIN_EMAIL="admin@zeina.store"
ADMIN_PHONE="+967776080395"

# --- Email Service (Brevo) - DISABLED IN DEMO MODE ---
# Emails are simulated in demo mode. No actual emails are sent.
BREVO_API_KEY="xkeysib-your-key-here"
BREVO_SENDER_EMAIL="noreply@yourdomain.com"
BREVO_SENDER_NAME="متجر زينة"

# --- Image Upload (Vercel Blob) - REPLACES ImageKit ---
# Get BLOB_READ_WRITE_TOKEN from Vercel dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN=""

# --- Real-time (Pusher) - DISABLED IN DEMO MODE ---
# Real-time updates use polling instead of Pusher in demo mode.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap2"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# --- Google OAuth - DISABLED IN DEMO MODE ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Google Gemini AI - DISABLED IN DEMO MODE ---
GEMINI_API_KEY=""

# --- Encryption Key (for payment details encryption) ---
ENCRYPTION_KEY="CHANGE_ME_TO_RANDOM_BASE64_KEY"

# --- CORS Configuration ---
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.vercel.app"

# --- Application ---
NODE_ENV="development"
APP_URL="http://localhost:3000"
CURRENCY_CODE="YER"

# --- Vercel ---
VERCEL_URL=""
